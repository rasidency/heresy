(install
 (section doc)
 (files lean-toolchain lakefile.toml lake-manifest.json
  (proof/Proof.lean as proof/Proof.lean)
  (proof/Execution.lean as proof/Execution.lean)
  (proof/Semantics.lean as proof/Semantics.lean)
  (proof/Synchronisation.lean as proof/Synchronisation.lean)
  (proof/Memory.lean as proof/Memory.lean)
  (proof/Patricia.lean as proof/Patricia.lean)
  (proof/Containers.lean as proof/Containers.lean)
  (proof/Runtime.lean as proof/Runtime.lean)
  (proof/Ordinary.lean as proof/Ordinary.lean)
  (proof/Surface.lean as proof/Surface.lean)
  (proof/Native.lean as proof/Native.lean)
  (proof/Schedule.lean as proof/Schedule.lean)
  (proof/Checker.lean as proof/Checker.lean)
  (proof/Certificate.lean as proof/Certificate.lean)
  (runtime/Heap.hs as runtime/Heap.hs)
  (assets/pipeline.svg as assets/pipeline.svg)
  (assets/capability.svg as assets/capability.svg)))

(rule
 (alias runtest)
 (deps (source_tree examples) (source_tree test/linkage) test/closed.c test/frames.c test/helpers.c test/recursive.c test/slots.c test/lowering.c test/values.c test/effects.c test/order.c)
 (action (run %{exe:test/verify.exe} %{exe:src/heresy.exe} %{exe:test/fault.exe})))


(rule
 (alias integration)
 (deps (universe) test/Replay.hs runtime/Heap.hs)
 (action (run %{exe:test/differential.exe} %{env:HERESY_REPLAY=../../.lake/build/bin/replay} runtime test/Replay.hs)))

(rule
 (alias integration)
 (deps (universe) (source_tree examples) (source_tree test))
 (action (run %{exe:test/verify.exe} --ordinary %{exe:src/heresy.exe} %{env:HERESY_CERTIFICATE=../../.lake/build/bin/certificate})))
