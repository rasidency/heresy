(rule
 (alias integration)
 (deps (universe) (source_tree ../../examples) (source_tree ..) ../../runtime/Heap.hs)
 (action (chdir %{workspace_root} (run sh %{dep:../scenario.sh} %{exe:../../src/heresy.exe} %{env:HERESY_CERTIFICATE=../../.lake/build/bin/certificate} %{dep:arguments.sh}))))

